# Copy to .env.local for local development (or .dev.vars for `npm run preview`).
# On Cloudflare: NEXT_PUBLIC_* go in the build variables; AIRTABLE_* go in the Worker's Variables and Secrets.

# Airtable personal access token (airtable.com/create/tokens).
# Scopes: data.records:write (website), plus schema.bases:read + schema.bases:write for `npm run airtable:setup`.
# Access: only the MAM-Core base.
AIRTABLE_TOKEN=
# Base ID, starts with "app" (from the base URL).
AIRTABLE_BASE_ID=
# Optional: table names, if you rename them.
AIRTABLE_WAITLIST_TABLE=Waitlist
AIRTABLE_MENTORS_TABLE=Mentor Applications

# Public site URL (used for the sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://mentamentee.com
# Keep "false" until launch so search engines don't index the pre-launch site.
NEXT_PUBLIC_ALLOW_INDEXING=false
